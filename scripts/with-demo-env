#!/usr/bin/env bash
set -euo pipefail
: "${AAP_TOKEN_FILE:?Set AAP_TOKEN_FILE to the private token file outside Git}"
export AAP_TOKEN="$(cat "$AAP_TOKEN_FILE")"
export AAP_URL="${AAP_URL:-https://aap-aap.apps.cluster-drjqz.dyn.redhatworkshops.io}"
if [[ "${1:-}" == codex ]]; then
  shift
  exec codex -c 'mcp_servers.aap={url="http://127.0.0.1:3017/mcp/caixa_demo",bearer_token_env_var="AAP_TOKEN",enabled_tools=["job_templates_list","job_templates_launch_create","jobs_retrieve","jobs_stdout_retrieve"]}' "$@"
fi
exec "$@"
